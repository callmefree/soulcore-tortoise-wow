# ============================================================
# .gitignore — 白名单模式：只跟踪项目文档/增量 SQL/ARPG Lua/工具脚本
# 排除：服务端二进制、MariaDB、地图/客户端数据、构建产物（体积巨大且可重装）
# ============================================================

# 根目录：默认全部忽略，再按需放行
/*
!.gitignore

# 文档（任意层级的 .md/.yml 小文件）
!*.md
!*.yml

# PlayerBots 工作线文档（子目录归档）
!/PlayerBots文档/
/PlayerBots文档/*
!/PlayerBots文档/*.md

# 增量 SQL（只跟踪 local_changes）
!/sql/
/sql/*
!/sql/local_changes/

# ARPG Lua 脚本 + 根目录散落的 lua
!/server/
/server/*
!/server/bin/
/server/bin/*
!/server/bin/lua_scripts/
!/super_hearthstone.lua

# 工具脚本（Python/测试样例）
!/工具/
/工具/*
!/工具/*.py
!/工具/*.sql
!/工具/*.md

# 素材（只跟踪文本类，忽略图片/压缩包/原文二进制）
!/素材/
/素材/*
!/素材/*.md
!/素材/*.txt
!/素材/*.csv
!/素材/*.json
!/素材/*.html
!/素材/**/*.md
!/素材/**/*.txt

# 遗留归档（含硬编码凭据的运维脚本，禁止入库；白名单模式下 _archive 默认已忽略，此处显式兜底）
_archive/py_遗留归档_*/
